{
  "name": "@playground/nestjs-mcp",
  "version": "0.1.16",
  "description": "Reusable, auth-free NestJS integration for the official MCP SDK over stateless Streamable HTTP.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --forceExit"
  },
  "dependencies": {
    "@playground/otel-extensions": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "nestjs-pino": "^5.0.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "reflect-metadata": ">=0.2.0 <1.0.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@opentelemetry/api-logs": "~0.221.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-logs": "~0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.0",
    "reflect-metadata": ">=0.2.2 <1.0.0",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
