{
  "name": "@playground/otel-extensions",
  "version": "0.1.16",
  "description": "Framework-agnostic OpenTelemetry building blocks — span helpers, dedicated-resource tracer providers, SDK bootstrap, and a pino-to-OTel-logs bridge.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --forceExit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.mjs --forceExit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "~0.221.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "~0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "~0.221.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "~0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "~0.221.0",
    "@opentelemetry/instrumentation": "~0.221.0",
    "@opentelemetry/instrumentation-http": "~0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "~0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "~0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "~0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "jest": "^30.5.0",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
